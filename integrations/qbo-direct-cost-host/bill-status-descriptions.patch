+// become price overrides or hide quantity/product/class changes.
+export function applySavedQboDescriptions(prepared, receipt) {
+ const payload=structuredClone(prepared.payload);
+ const byId=new Map((receipt.managedLines || []).filter(line=>line.ItemBasedExpenseLineDetail).map(line=>[String(line.Id),line]));
+ const items=payload.Line.filter(line=>line.ItemBasedExpenseLineDetail);
+ for(let i=0;i<items.length;i++) {
+  const id=receipt.sourceBindings?.[prepared.source?.[i]?.lineKey];
+  const saved=id && byId.get(String(id));
+  if(!saved)continue;
+  if(Object.hasOwn(saved,'Description'))items[i].Description=saved.Description;
+  else delete items[i].Description;
+ }
+ return {...prepared,payload,fingerprint:hash({source:prepared.fingerprint,payload})};
