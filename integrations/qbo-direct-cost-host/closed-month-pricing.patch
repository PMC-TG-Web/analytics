+import { savedPrepared } from './qbo-managed-bill.js';
+
+// The accounting page and host use the same business timezone, independent of
+// the server's timezone. A month remains open until local midnight on the first.
+export function isClosedBillMonth(month, now = new Date()) {
+  if (!/^20\d{2}-(0[1-9]|1[0-2])$/.test(month)) throw new Error('Invalid bill month.');
+  const parts = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', year: 'numeric', month: '2-digit' }).formatToParts(now);
+  const current = `${parts.find(p => p.type === 'year').value}-${parts.find(p => p.type === 'month').value}`;
+  return month < current;
+}
+
+// Only a successful receipt may supply history. Never use catalog history,
+// draft prices, product names, or a failed/pending replacement as a baseline.
+export async function closedMonthPrices(claim, receipt, prepared) {
+  const saved = await savedPrepared(claim, receipt);
+  if (saved.identity !== prepared.identity) throw new Error('Closed-month price history does not match this bill.');
+  const sources = new Map((saved.source || []).map(source => [source.lineKey, source]));
+  const prices = new Map();
+  const additions = new Set((saved.preservedLines || []).map(line => String(line.Id)));
+  const items = (saved.payload?.Line || []).filter(line => line.ItemBasedExpenseLineDetail && !(line.Id && additions.has(String(line.Id))));
+  for (let index = 0; index < items.length; index++) {
+    const keys = saved.itemSourceKeys?.[index] || [saved.source?.[index]?.lineKey];
+    for (const key of keys) {
+      if (!key || !sources.has(key) || prices.has(key)) throw new Error('Closed-month price ownership requires reconciliation.');
+      prices.set(key, items[index].ItemBasedExpenseLineDetail.UnitPrice);
+    }
+  }
+  const result = {};
+  for (const source of prepared.source || []) {
+    // Food's quantity-one rate represents a changing expense total, not a unit price.
+    if (source.sourceType === 'manual_food') continue;
+    const old = sources.get(source.lineKey);
+    if (!old) continue; // New source lines still need normal pricing and review.
+    if (old.sourceType !== source.sourceType || old.uom !== source.uom) throw new Error('A closed-month source unit or type changed; price history requires reconciliation.');
+    const price = prices.get(source.lineKey);
+    if (!Number.isFinite(Number(price)) || Number(price) <= 0) throw new Error('A saved closed-month unit price is unavailable; reconciliation is required.');
+    result[source.lineKey] = { unitCost: String(price), closedMonth: true };
+  }
+  return result;
+}
