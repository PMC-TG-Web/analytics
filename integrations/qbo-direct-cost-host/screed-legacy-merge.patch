+test('deleted manual-only Telebelts stay deleted and do not block the retained automatic lines',async()=>{
+ const dir=await mkdtemp(path.join(os.tmpdir(),'qbo-deleted-telebelt-'));
+ try {
+  const f=fixture(),telebelt=item('3',1500);telebelt.Description='Telebelt';
+  f.receipt.managedLines.push(telebelt);f.receipt.managedLines[1].Amount=-2700;
+  f.receipt.sourceBindings.telebelt='3';f.receipt.sourceKeys.push('telebelt');
+  await writeFile(path.join(dir,'attempt.json'),JSON.stringify({...f.prepared,source:[...f.prepared.source,{lineKey:'telebelt',costType:'Equipment'}]}));
+  const merged=await mergeQboBill({...f,claim:dir});
+  assert.equal(merged.payload.Line.length,2);assert.equal(merged.total,0);
+  assert.deepEqual(merged.preservedLines,[]);
+  // An included automatic source is never treated as a manual deletion.
+  f.prepared.source.push({lineKey:'telebelt',description:'Telebelt'});
+  await assert.rejects(mergeQboBill({...f,claim:dir}),/Telebelt.*deleted/);
+ } finally {await rm(dir,{recursive:true,force:true});}
+});
