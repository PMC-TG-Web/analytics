+import { syncMonthlyBill } from '../src/monthly-bill-sync.js';
+import { reviewBillReconciliation } from '../src/bill-reconciliation.js';
+
+const item = (Id, product, amount, cls) => ({ Id, Description: product, Amount: amount,
+  DetailType: 'ItemBasedExpenseLineDetail', ItemBasedExpenseLineDetail: {
+    ItemRef: { value: product, name: `TEST-${product}` }, CustomerRef: { value: '20' },
+    ClassRef: { value: cls }, Qty: 1, UnitPrice: amount, BillableStatus: 'NotBillable' } });
+const offset = (Id, account, amount, cls) => ({ Id, Description: `${account} offset`, Amount: amount,
+  DetailType: 'AccountBasedExpenseLineDetail', AccountBasedExpenseLineDetail: {
+    AccountRef: { value: account, name: account === '333' ? 'Wages:Labor -' : 'Direct Costs -' },
+    ClassRef: { value: cls }, BillableStatus: 'NotBillable' } });
+
+async function fixture(run) {
+  const directory = await mkdtemp(path.join(os.tmpdir(), 'qbo-skip-priority-'));
+  try {
+    const payload = { DocNumber: 'Example 001', VendorRef: { value: '4' }, TxnDate: '2026-10-01', PrivateNote: 'app',
+      Line: [item('1', 'screed.LS', 1200, 'srs'), item('2', 'labor.L', 100, 'flat'),
+        offset('3', '331', -1200, 'srs'), offset('4', '333', -100, 'flat')] };
+    const saved = { identity: 'a'.repeat(64), fingerprint: 'b'.repeat(64), requestId: `pc-${'a'.repeat(40)}`,
+      payload, source: [{ lineKey: 'screed', qboItemName: 'TEST-screed.LS' }, { lineKey: 'labor', qboItemName: 'TEST-labor.L' }],
+      total: 0, grossTotal: 1300 };
+    const claim = path.join(directory, saved.identity); await mkdir(claim);
+    await writeFile(path.join(claim, 'attempt.json'), JSON.stringify(saved));
+    const receipt = { billId: '100', syncToken: '1', docNumber: payload.DocNumber, privateNote: payload.PrivateNote,
+      fingerprint: saved.fingerprint, sourceBindings: { screed: '1', labor: '2' }, sourceKeys: ['screed', 'labor'],
+      managedLines: structuredClone(payload.Line) };
+    const prepared = { ...structuredClone(saved), source: [saved.source[1]], ignoredLineKeys: ['screed'], grossTotal: 100,
+      payload: { ...structuredClone(payload), Line: structuredClone([payload.Line[1], payload.Line[3]]) } };
+    const manual = item('8', 'screed.LS', 5000, 's15'); manual.Description = 'S15 entered in QBO';
+    manual.ItemBasedExpenseLineDetail.Qty = 2; manual.ItemBasedExpenseLineDetail.UnitPrice = 2500;
+    const manualOffset = offset('7', '331', -5000, 's15'); delete manualOffset.Description;
+    const current = { ...structuredClone(payload), Id: '100', SyncToken: '2', TotalAmt: 0, Balance: 0,
+      Line: structuredClone([payload.Line[1], manual, payload.Line[3], manualOffset]) };
+    await run({ directory, claim, prepared, receipt, current, manual, manualOffset });
+  } finally {
+    assert.match(path.relative(os.tmpdir(), directory), /^qbo-skip-priority-[^\\/]+$/);
+    await rm(directory, { recursive: true, force: true });
+  }
+}
+
+for (const reconciled of [false, true]) {
+  test(`skipped QBO replacement and its unnamed offset win${reconciled ? ' after a previous reconciliation' : ' without reconciliation'}`, async () => fixture(async f => {
+    if (reconciled) Object.assign(f.receipt, { reconciliationPending: true, syncToken: f.current.SyncToken, preservedLines: [] });
+    await writeFile(path.join(f.claim, 'receipt.json'), JSON.stringify(f.receipt));
+    const original = structuredClone({ prepared: f.prepared, current: f.current, receipt: f.receipt });
+    let merged = await mergeQboBill(f);
+    assert.deepEqual(merged.preservedLines, [f.manual, f.manualOffset]);
+    assert.deepEqual(merged.skippedSourceBindings, { screed: '1' });
+    assert.equal(merged.payload.Line.some(l => l.Id === '1' || l.Id === '3'), false);
+    assert.equal(merged.total, 0);
+    assert.deepEqual({ prepared: f.prepared, current: f.current, receipt: f.receipt }, original);
+    const review = await reviewBillReconciliation({ directory: f.directory, prepared: merged, mapping: {}, readBill: async () => f.current });
+    assert.equal(review.automatic, true); assert.equal(review.manuallyChanged, false);
+    assert.equal(review.preserved.total, 0); assert.equal(review.preserved.rows.length, 4);
+    f.receipt = await syncMonthlyBill({ directory: f.directory, prepared: merged, readBill: async () => f.current,
+      updateBill: async () => { throw Error('An already matching QBO bill must not be rewritten'); } });
+    assert.equal(f.receipt.alreadyPosted, true);
+    // A later labor update keeps both exact QBO lines; the skipped source stays absent.
+    f.prepared.payload.Line[0].Amount = 200; f.prepared.payload.Line[0].ItemBasedExpenseLineDetail.Qty = 2;
+    f.prepared.payload.Line[1].Amount = -200;
+    merged = await mergeQboBill(f);
+    assert.deepEqual(merged.preservedLines, [f.manual, f.manualOffset]);
+    let writes = 0;
+    f.receipt = await syncMonthlyBill({ directory: f.directory, prepared: merged, readBill: async () => f.current,
+      updateBill: async revision => {
+        writes++; assert.equal(revision.total, 0);
