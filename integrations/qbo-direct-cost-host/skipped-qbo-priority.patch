+    merged = await mergeQboBill(f);
+    const repeated = await syncMonthlyBill({ directory: f.directory, prepared: merged, readBill: async () => f.current,
+      updateBill: async () => { throw Error('A repeated update must not write again'); } });
+    assert.equal(repeated.alreadyPosted, true); assert.equal(writes, 1);
+  }));
