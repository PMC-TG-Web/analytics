+import { createHash } from 'node:crypto';
+import { offsetForItem } from './qbo-manual-offsets.js';
+import { screederKey } from './screeding-classes.js';
+
+const cents = value => Math.round(Number(value) * 100);
+const subcontractCodes = new Set(['03-300-00-50','03-300-10-50','03-300-20-50','03-300-30-50','04-100-10-20']);
+export function entryPriorityCategory(source, item, screeder = false) {
+  if (source?.sourceType === 'timecard' || source?.sourceType === 'manual_food') return null;
+  const text = String(source?.description || item?.Description || '').normalize('NFKC');
+  const code = String(source?.costCode || '').replace(/\.[A-Z]+$/i, '');
+  const type = String(source?.sourceCostType || source?.costType || '').trim();
+  const product = String(source?.qboItemName || item?.ItemBasedExpenseLineDetail?.ItemRef?.name || '');
+  if (screeder || /\.LS$/i.test(product) || /^(ls|labor laser screeding)$/i.test(type) || (screederKey(text) && screederKey(text) !== 'profiler')) return 'screeding';
+  if (/\b(?:trucking|dump[ -]*trucks?|hauling)\b/i.test(text)) return 'trucking';
+  if (/^(s|sub[ -]*contract(?:or|ors|ing)?)$/i.test(type) || /\.S$/i.test(product) || subcontractCodes.has(code) || /\bsub[ -]*contract(?:ors?|ing)?\b/i.test(text)) return 'subcontractor';
+  return null;
+}
+const identity = line => {
+  const d = line?.ItemBasedExpenseLineDetail || {};
+  return JSON.stringify([line?.DetailType,line?.Description || '',d.ItemRef?.value || '',d.CustomerRef?.value || '',d.ClassRef?.value || '',d.BillableStatus || '',d.TaxCodeRef?.value || '',d.UnitPrice]);
+};
+
+/** Remove only receipt-bound protected entries from automatic ownership.
+ * The existing Skip merge keeps their exact live fields and balanced offsets.
+ * Names classify a source; they never establish a QBO line's identity.
+ */
+export function preserveDifferingQboEntries(prepared, state, current, receipt) {
+  if (!prepared.preserveQboEntries) return prepared;
+  const items = prepared.payload.Line.filter(line => line.ItemBasedExpenseLineDetail);
+  if (items.length !== prepared.source.length) throw new Error('Entry preservation requires unaggregated source identity.');
+  const rows = new Map(prepared.source.map((source,index) => [source.lineKey,{source,item:items[index]}]));
+  const groups = new Map();
+  for (const [key,id] of Object.entries(state.bindings)) {
+    if (!groups.has(String(id))) groups.set(String(id),[]);
+    groups.get(String(id)).push(key);
+  }
+  const prior = new Set(receipt.qboEntryPreservedKeys || []), keep = new Set();
+  for (const [id,keys] of groups) {
+    const old = state.lines.find(line => String(line.Id) === id);
+    const live = current.Line.find(line => String(line.Id) === id);
+    const active = keys.map(key => rows.get(key)).filter(Boolean);
+    const eligible = keys.map(key => prior.has(key) || !!entryPriorityCategory(rows.get(key)?.source || {sourceType:key.startsWith('labor:') ? 'timecard' : 'productivity'},old,(prepared.screedingLineKeys || []).includes(key)));
+    if (!eligible.some(Boolean)) continue;
+    const same = live && active.length === keys.length && active.every(row => identity(row.item) === identity(live))
+      && Math.abs(active.reduce((n,row)=>n+Number(row.item.ItemBasedExpenseLineDetail.Qty),0)-Number(live.ItemBasedExpenseLineDetail?.Qty)) < 1e-8
+      && active.reduce((n,row)=>n+cents(row.item.Amount),0) === cents(live.Amount);
+    if (same && !keys.some(key=>prior.has(key))) continue;
+    if (!eligible.every(Boolean)) throw new Error('A protected QBO entry shares a line with another source; reconciliation is required.');
+    // A different project is an identity problem, not an intentional price edit.
+    if (live && (!live.ItemBasedExpenseLineDetail || live.ItemBasedExpenseLineDetail.CustomerRef?.value !== old?.ItemBasedExpenseLineDetail?.CustomerRef?.value)) throw new Error('Protected QBO entry project or line type changed; reconciliation is required.');
+    keys.forEach(key=>keep.add(key));
+  }
+  if (!keep.size) return prepared;
+  if (cents(current.TotalAmt) !== 0 || current.Line.reduce((n,line)=>n+cents(line.Amount),0) !== 0) throw new Error('Protected QBO entries require a balanced live bill; reconciliation is required.');
+  const payload = structuredClone(prepared.payload);
+  const offsets = payload.Line.filter(line=>line.AccountBasedExpenseLineDetail);
+  for (const [key,row] of rows) if (keep.has(key)) {
+    const offset = offsetForItem({payload},row.source,row.item);
+    if (offset) offset.Amount = (cents(offset.Amount)+cents(row.item.Amount))/100;
+  }
+  payload.Line = [...items.filter((_,i)=>!keep.has(prepared.source[i].lineKey)).map(line=>structuredClone(line)),...offsets.filter(line=>cents(line.Amount)!==0)];
+  const source = prepared.source.filter(row=>!keep.has(row.lineKey));
+  const qboEntryPreservedKeys = [...keep].sort();
+  return {...prepared,payload,source,qboEntryPreservedKeys,
+    ignoredLineKeys:[...new Set([...(prepared.ignoredLineKeys || []),...keep])].sort(),
+    fingerprint:createHash('sha256').update(JSON.stringify({source:prepared.fingerprint,payload,qboEntryPreservedKeys})).digest('hex')};
+}
