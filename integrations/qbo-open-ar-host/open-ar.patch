diff --git a/test/open-ar.test.js b/test/open-ar.test.js
new file mode 100644
--- /dev/null
+++ b/test/open-ar.test.js
@@ -0,0 +1,49 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createDirectCostBillService } from '../src/direct-cost-bill-service.js';
+import { IntuitClient } from '../src/intuit-client.js';
+
+test('Open A/R validates company before connecting and uses only the reader with writes disabled', async () => {
+  let connections = 0;
+  const reader = {
+    async query(query) {
+      assert.match(query, /^select \* from (Invoice|Class|Customer|Payment|CreditMemo) /);
+      return { QueryResponse: {} };
+    },
+    async getReport(name) {
+      assert.equal(name, 'AgedReceivables');
+      return { Header: { Currency: 'USD', Option: [{ Name: 'report_date', Value: '2026-11-05' }, { Name: 'NoReportData', Value: 'true' }] } };
+    },
+  };
+  const service = createDirectCostBillService({
+    directory: 'must-not-be-read-for-ar', environment: 'production', realmId: '456', companyId: '123',
+    writesEnabled: false, now: () => new Date('2026-11-05T14:00:00Z'),
+    connect: async () => {
+      connections++;
+      return { reader, get writer() { throw new Error('Writer must never be accessed'); }, get productWriter() { throw new Error('Product writer must never be accessed'); } };
+    },
+  });
+
+  test('read-only report and query calls pass explicit abort signals without changing other callers', async () => {
+    const calls = [];
+    const client = new IntuitClient({ accessToken: 'test', realmId: '456', environment: 'sandbox', fetchImpl: async (url, options) => {
+      calls.push(options);
+      return new Response('{}', { headers: { 'Content-Type': 'application/json' } });
+    } });
+    const signal = AbortSignal.timeout(1000);
+    await client.query('select * from Invoice', { signal });
+    await client.getReport('AgedReceivables', {}, { signal });
+    await client.query('select * from Class');
+    assert.equal(calls[0].signal, signal); assert.equal(calls[1].signal, signal);
+    assert.equal(calls[2].signal, undefined);
+    assert.ok(calls.every(call => call.method === 'GET'));
+  });
+  await assert.rejects(service({ operation: 'open-ar', companyId: '999' }), /company/);
+  assert.equal(connections, 0);
+  const result = await service({ operation: 'open-ar', companyId: '123' });
+  assert.equal(connections, 1);
+  assert.equal(result.companyId, '123');
+  assert.equal(result.realmId, '456');
+  assert.deepEqual(result.invoices, []);
+  assert.equal(result.qboAging.total, 0);
+});
