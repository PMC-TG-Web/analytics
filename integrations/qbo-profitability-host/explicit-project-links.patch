+
+export function scopedProfitabilityProjectLinks(payload, scope) {
+  if (payload?.version !== 1 || !Array.isArray(payload.links)) {
+    throw new Error('Invalid profitability project-link configuration.');
+  }
+  const byScope = new Map();
+  for (const link of payload.links) {
+    if (!['production', 'sandbox'].includes(link?.environment)
+      || !['realmId', 'companyId', 'qboCustomerId', 'procoreProjectId']
+        .every((field) => typeof link[field] === 'string' && /^\d+$/.test(link[field]))) {
+      throw new Error('Profitability project links require an environment and explicit numeric IDs.');
+    }
+    const key = JSON.stringify([link.environment, link.realmId, link.companyId]);
+    const entries = byScope.get(key) || new Map();
+    if (entries.has(link.qboCustomerId) || [...entries.values()].includes(link.procoreProjectId)) {
+      throw new Error('Duplicate or conflicting profitability project links.');
+    }
+    entries.set(link.qboCustomerId, link.procoreProjectId);
+    byScope.set(key, entries);
+  }
+  return byScope.get(JSON.stringify([scope.environment, scope.realmId, scope.companyId])) || new Map();
+}
