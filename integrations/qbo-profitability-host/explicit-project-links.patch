diff --git a/test/profitability-project-links.test.js b/test/profitability-project-links.test.js
new file mode 100644
--- /dev/null
+++ b/test/profitability-project-links.test.js
@@ -0,0 +1,68 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { buildProjectUniverse, scopedProfitabilityProjectLinks } from '../src/project-profitability.js';
+
+const scope = { environment: 'production', realmId: '100', companyId: '200' };
+const link = { ...scope, qboCustomerId: '300', procoreProjectId: '400' };
+const config = { version: 1, links: [link] };
+const customers = new Map([['300', { Id: '300', DisplayName: 'Giorgia Slab', Job: true, Active: true }]]);
+const projects = [{ id: '400', name: 'Giorgio Slab', projectNumber: '2606-GMBS', status: 'Complete' }];
+const activity = [{ qboCustomerId: '300', projectName: 'Giorgia Slab', recordType: 'project', actualCost: 125.5 }];
+const links = () => scopedProfitabilityProjectLinks(config, scope);
+
+test('explicit IDs link different names without a zero placeholder or changed costs', () => {
+  const rows = buildProjectUniverse(activity, customers, projects, links());
+  assert.equal(rows.length, 1);
+  assert.equal(rows[0].qboCustomerId, '300');
+  assert.equal(rows[0].procoreProjectId, '400');
+  assert.equal(rows[0].procoreMatchMethod, 'explicit-id');
+  assert.equal(rows[0].actualCost, 125.5);
+});
+
+test('explicit identity survives renamed projects and overrides misleading exact names', () => {
+  const alternatives = [{ id: '500', name: 'Giorgia Slab', status: 'Complete' }, { ...projects[0], name: 'Renamed' }];
+  const rows = buildProjectUniverse(activity, customers, alternatives, links());
+  assert.equal(rows.find((row) => row.qboCustomerId === '300').procoreProjectId, '400');
+});
+
+test('a second QBO customer cannot claim a project reserved by an explicit link', () => {
+  const rows = buildProjectUniverse([...activity, {
+    qboCustomerId: '301', projectName: 'Giorgio Slab', recordType: 'project', actualCost: 999,
+  }], customers, projects, links());
+  assert.equal(rows.length, 1);
+  assert.equal(rows[0].actualCost, 125.5);
+});
+
+test('zero-activity explicit links retain the real QBO ID for future refreshes', () => {
+  const rows = buildProjectUniverse([], customers, projects, links());
+  assert.equal(rows.length, 1);
+  assert.equal(rows[0].qboCustomerId, '300');
+  assert.equal(rows[0].procoreMatchMethod, 'explicit-id');
+  assert.equal(rows[0].actualCost, 0);
+});
+
+test('links never cross environment, QBO realm, or Procore company boundaries', () => {
+  for (const changed of [{ environment: 'sandbox' }, { realmId: '101' }, { companyId: '201' }]) {
+    assert.equal(scopedProfitabilityProjectLinks(config, { ...scope, ...changed }).size, 0);
+  }
+});
+
+test('invalid and conflicting IDs fail before a replacement snapshot is generated', () => {
+  for (const payload of [
+    {}, { version: 1, links: [{ ...link, qboCustomerId: 'Giorgia' }] },
+    { version: 1, links: [link, link] },
+    { version: 1, links: [link, { ...link, procoreProjectId: '401' }] },
+    { version: 1, links: [link, { ...link, qboCustomerId: '301' }] },
+  ]) assert.throws(() => scopedProfitabilityProjectLinks(payload, scope));
+  assert.throws(() => buildProjectUniverse(activity, new Map(), projects, links()), /no QBO project/);
+  assert.throws(() => buildProjectUniverse(activity, customers, [], links()), /no Procore project/);
+});
+
+test('explicit links preserve the existing project-status eligibility rule', () => {
+  assert.deepEqual(buildProjectUniverse(activity, customers, [{ ...projects[0], status: 'Lost' }], links()), []);
+});
+
+test('other projects retain the existing name-matching behavior', () => {
+  const rows = buildProjectUniverse([{ ...activity[0], projectName: 'Giorgio Slab' }], customers, projects);
+  assert.equal(rows[0].procoreMatchMethod, 'exact-name');
+});
